# URL pública (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://vorioncode.com
# E-mail exibido no site e destino do formulário quando não há serviço de formulário
NEXT_PUBLIC_CONTACT_EMAIL=contato@vorioncode.com
# Opcional: endpoint de um serviço de formulário (ex.: https://formspree.io/f/xxxxxx).
# Sem ele, "Enviar mensagem" abre o app de e-mail do visitante com a mensagem pronta.
NEXT_PUBLIC_FORM_ENDPOINT=
