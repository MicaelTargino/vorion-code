# URL pública (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://vorioncode.com
# E-mail exibido no site (rodapé, botão "Enviar um e-mail")
NEXT_PUBLIC_CONTACT_EMAIL=contato@vorioncode.com

# Envio do formulário via Resend (https://resend.com). Só no servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remetente verificado no Resend (precisa do domínio verificado lá)
CONTACT_FROM_EMAIL="Vorion Code <site@vorioncode.com>"
